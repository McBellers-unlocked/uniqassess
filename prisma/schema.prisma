// UNIQAssess — standalone AI-era professional assessment platform.
//
// All tables are recruitment-specific (carved out from the Callater repo) plus
// a minimal `User` model used by the admin sign-in flow. The candidate flow
// does not use the User table at all — it is token-based.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEMO
}

// Declared policy for how AI may be used in an assessment. The scenario owns
// the editable choice; RecruitmentAssessment stores an immutable snapshot.
enum RecruitmentAssessmentMode {
  EVIDENCE
  COPILOT
  OPEN_AGENT
}

enum RecruitmentEvidenceVerificationStatus {
  VERIFIED
  UNVERIFIED
  INFERENCE
}

enum RecruitmentEvidenceDisposition {
  SAVED
  CHECKED
  REJECTED
  DISMISSED
}

enum RecruitmentValidationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum RecruitmentScenarioReviewType {
  SUBJECT_MATTER
  ASSESSMENT_DESIGN
  ACCESSIBILITY
}

enum RecruitmentScenarioReviewDecision {
  APPROVED
  CHANGES_REQUIRED
  APPROVED_WITH_LIMITATIONS
}

enum RecruitmentPsychometricProgrammeStatus {
  DRAFT
  STUDY_READY
  PILOT_ACTIVE
  ANALYSIS
  EVIDENCE_REVIEW
  ARCHIVED
}

enum RecruitmentPsychometricEvidenceCategory {
  CONTENT
  RESPONSE_PROCESS
  RATER_RELIABILITY
  RELATIONS_TO_OTHER_VARIABLES
  FAIRNESS
  CONSEQUENCES
}

enum RecruitmentPsychometricEvidenceStatus {
  NOT_STARTED
  PLANNED
  IN_PROGRESS
  EVIDENCE_AVAILABLE
  INSUFFICIENT
  NOT_APPLICABLE
}

enum RecruitmentPsychometricConclusion {
  NOT_EVALUATED
  INSUFFICIENT_EVIDENCE
  SUPPORTS_INTENDED_USE
  SUPPORTS_WITH_LIMITATIONS
  DOES_NOT_SUPPORT_INTENDED_USE
}

enum RecruitmentPilotVersionBasis {
  CAPTURED_AT_CREATION
  LINKED_BEFORE_PARTICIPATION
  RETROSPECTIVE_ATTESTATION
}

enum RecruitmentRaterAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
}

// -------------------------------------------------------------------
// Admin account (NextAuth / Cognito-backed).
// Candidates do NOT live here — see RecruitmentCandidate.
// -------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demoSession                   RecruitmentDemoSession?
  validationRuns                RecruitmentScenarioValidationRun[]
  scenarioReviews               RecruitmentScenarioReview[]
  publicationOverrides          RecruitmentScenarioPublicationOverride[]
  assessmentVersionsCreated     RecruitmentAssessmentVersion[]           @relation("AssessmentVersionCreator")
  psychometricProgrammesCreated RecruitmentPsychometricProgramme[]       @relation("PsychometricProgrammeCreator")
  psychometricEvidenceUpdated   RecruitmentPsychometricEvidence[]        @relation("PsychometricEvidenceUpdater")
  psychometricRaterAssignments  RecruitmentPsychometricRaterAssignment[] @relation("PsychometricRater")
}

// -------------------------------------------------------------------
// Tokenized demo sessions for prospect-facing self-serve trials.
// One row per share-with-prospect URL: clicking the activation link
// signs the user in as the linked DEMO User. Demo users see only
// scenarios they created themselves (`createdById` scope) and have
// no access to candidates / results / cohorts.
//
// Mint via scripts/mint-demo-session.ts; revoke by setting revokedAt.
// -------------------------------------------------------------------
model RecruitmentDemoSession {
  id        String    @id @default(cuid())
  token     String    @unique // 64-char hex; appears in the URL
  name      String // for the operator's records, e.g. "WIPO Director"
  email     String? // optional contact email
  userId    String    @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([expiresAt])
  @@map("recruitment_demo_sessions")
}

// ============================================================================
// Recruitment assessment flow — admin-managed, per-candidate tokens, blind
// marking with reveal. Lives at /assess/[scenarioSlug]?token=… (candidate)
// and /admin/recruitment/* (admin).
// ============================================================================

model RecruitmentAssessment {
  id               String               @id @default(cuid())
  title            String // e.g. "Finance and Accounting Manager (P4)"
  scenarioSlug     String               @map("scenario_slug") // routes the candidate URL: /assess/<slug>
  scenarioId       String               @map("scenario_id") // matches src/lib/recruit/scenarios key, e.g. "fam-p4-2026"
  // If set, resolves to a DB-backed RecruitmentScenario (admin-authored).
  // Takes precedence over scenarioId. scenarioId/scenarioSlug are still
  // populated (mirrored from the DB scenario) for backwards compatibility.
  customScenarioId String?              @map("custom_scenario_id")
  customScenario   RecruitmentScenario? @relation(fields: [customScenarioId], references: [id], onDelete: SetNull)
  totalMinutes     Int                  @default(90) @map("total_minutes")
  openDate         DateTime             @map("open_date")
  closeDate        DateTime             @map("close_date")
  revealedAt       DateTime?            @map("revealed_at") // when the admin clicks "Reveal Candidates"
  createdAt        DateTime             @default(now()) @map("created_at")
  createdById      String?              @map("created_by_id")

  // Immutable policy/config snapshot copied from the scenario at cohort
  // creation. Defaults preserve the behaviour of existing cohorts.
  assessmentMode       RecruitmentAssessmentMode @default(EVIDENCE) @map("assessment_mode")
  modePolicyVersion    String                    @default("1") @map("mode_policy_version")
  defenceEnabled       Boolean                   @default(false) @map("defence_enabled")
  defenceQuestionCount Int                       @default(2) @map("defence_question_count")
  defenceMinutes       Int                       @default(5) @map("defence_minutes")

  // Immutable scenario/rubric/exhibit snapshot. New DB-backed cohorts capture
  // this automatically so later scenario edits cannot change what candidates
  // or markers see for the cohort.
  assessmentVersionId String?                       @map("assessment_version_id")
  assessmentVersion   RecruitmentAssessmentVersion? @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict)

  candidates             RecruitmentCandidate[]
  psychometricPilotLinks RecruitmentPsychometricPilotCohort[]

  @@index([customScenarioId])
  @@index([assessmentVersionId])
  @@map("recruitment_assessments")
}

model RecruitmentCandidate {
  id           String                @id @default(cuid())
  assessmentId String                @map("assessment_id")
  assessment   RecruitmentAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  name        String // hidden during marking
  email       String
  token       String @unique // FAM-XXXX
  anonymousId String @map("anonymous_id") // "Candidate A", "Candidate AD" — UNIQUE per assessment
  status      String @default("invited") // invited | started | submitted | expired

  startedAt   DateTime? @map("started_at") // server-side timer anchor
  submittedAt DateTime? @map("submitted_at")
  deadline    DateTime? // startedAt + assessment.totalMinutes; cached for fast checks

  // Single-use enforcement: first browser to start the session sets these.
  // Subsequent attempts with a different cookie are rejected.
  sessionToken     String? @map("session_token")
  sessionUserAgent String? @map("session_user_agent")
  sessionIpHash    String? @map("session_ip_hash")

  // Marker outputs (populated in Half 2)
  totalScore Float? @map("total_score")

  // The main work is irrevocably locked before a configured defence starts.
  workLockedAt               DateTime? @map("work_locked_at")
  toolDeclaration            Json?     @map("tool_declaration")
  toolDeclarationSubmittedAt DateTime? @map("tool_declaration_submitted_at")

  responses                    RecruitmentResponse[]
  interactions                 RecruitmentInteraction[]
  activityEvents               RecruitmentActivityEvent[]
  emailResponses               RecruitmentEmailResponse[]
  evidenceBoard                RecruitmentCandidateEvidence[]
  labSessions                  RecruitmentLabSession[]
  awsLabSessions               RecruitmentAwsLabSession[]
  defence                      RecruitmentCandidateDefence?
  psychometricRaterAssignments RecruitmentPsychometricRaterAssignment[]

  @@unique([assessmentId, anonymousId])
  @@unique([assessmentId, email])
  @@index([assessmentId])
  @@map("recruitment_candidates")
}

// Direct candidate-operated lab evidence; separate from AI interactions and scores.
model RecruitmentLabSession {
  id          String               @id @default(cuid())
  candidateId String               @map("candidate_id")
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  taskNumber  Int                  @map("task_number")
  templateId  String               @map("template_id")
  status      String               @default("starting")
  expiresAt   DateTime             @map("expires_at")
  error       String?              @db.Text
  snapshot    Json?
  cleanupCompletedAt DateTime?     @map("cleanup_completed_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  commands    RecruitmentLabCommand[]

  @@unique([candidateId, taskNumber])
  @@index([status, expiresAt])
  @@map("recruitment_lab_sessions")
}

model RecruitmentLabCommand {
  id         String                @id @default(uuid()) @db.Uuid
  sessionId  String                @map("session_id")
  session    RecruitmentLabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestId  String                @map("request_id") @db.Uuid
  command    String                @db.Text
  status     String                @default("queued")
  stdout     String                @default("") @db.Text
  stderr     String                @default("") @db.Text
  exitCode   Int?                  @map("exit_code")
  truncated  Boolean               @default(false)
  createdAt  DateTime              @default(now()) @map("created_at")
  startedAt  DateTime?             @map("started_at")
  finishedAt DateTime?             @map("finished_at")

  @@unique([sessionId, requestId])
  @@index([sessionId, createdAt])
  @@map("recruitment_lab_commands")
}

// AWS evidence is isolated from Kubernetes reconciliation and runner routing.
model RecruitmentAwsLabSession {
  id          String               @id @default(cuid())
  candidateId String               @map("candidate_id")
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  taskNumber  Int                  @map("task_number")
  templateId  String               @map("template_id")
  status      String               @default("starting")
  expiresAt   DateTime             @map("expires_at")
  error       String?              @db.Text
  snapshot    Json?
  cleanupCompletedAt DateTime?     @map("cleanup_completed_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  commands    RecruitmentAwsLabCommand[]

  @@unique([candidateId, taskNumber])
  @@index([status, expiresAt])
  @@map("recruitment_aws_lab_sessions")
}

model RecruitmentAwsLabCommand {
  id         String                @id @default(uuid()) @db.Uuid
  sessionId  String                @map("session_id")
  session    RecruitmentAwsLabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestId  String                @map("request_id") @db.Uuid
  command    String                @db.Text
  status     String                @default("queued")
  stdout     String                @default("") @db.Text
  stderr     String                @default("") @db.Text
  exitCode   Int?                  @map("exit_code")
  truncated  Boolean               @default(false)
  createdAt  DateTime              @default(now()) @map("created_at")
  startedAt  DateTime?             @map("started_at")
  finishedAt DateTime?             @map("finished_at")

  @@unique([sessionId, requestId])
  @@index([sessionId, createdAt])
  @@map("recruitment_aws_lab_commands")
}

model RecruitmentResponse {
  id          String               @id @default(cuid())
  candidateId String               @map("candidate_id")
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  taskNumber  Int                  @map("task_number")
  content     String               @db.Text
  wordCount   Int                  @default(0) @map("word_count")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  // When the candidate explicitly "sent" this memo (per-task finalise +
  // advance-to-next). Null = still a draft. The overall submit remains the
  // hard finaliser; sending is a soft, re-doable signal.
  sentAt      DateTime?            @map("sent_at")

  // Marker output (Half 2)
  score               Float?
  comments            String?                         @db.Text
  issuesIdentified    Json?                           @map("issues_identified") // string[] of issue IDs the candidate found - analytics only
  // Human-entered criterion scores keyed by stable criterion ID. These make
  // descriptive pilot distributions possible without deriving or auto-scoring.
  criterionScores     Json?                           @map("criterion_scores")
  markedAt            DateTime?                       @map("marked_at")
  markedById          String?                         @map("marked_by_id")
  psychometricRatings RecruitmentPsychometricRating[]

  @@unique([candidateId, taskNumber])
  @@map("recruitment_responses")
}

model RecruitmentInteraction {
  id          String               @id @default(uuid()) @db.Uuid
  candidateId String               @map("candidate_id")
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sequenceNum Int                  @default(autoincrement()) @map("sequence_num")
  taskNumber  Int                  @map("task_number")
  timestamp   DateTime             @default(now())
  actor       String // candidate | ai
  content     String               @db.Text
  tokenCount  Int?                 @map("token_count")
  metadata    Json?

  // Additive structured-response fields. Historical rows remain valid and
  // render through `content` when these fields are null.
  structuredPayload   Json?                      @map("structured_payload")
  schemaVersion       String?                    @map("schema_version")
  model               String?
  promptPolicyVersion String?                    @map("prompt_policy_version")
  assessmentMode      RecruitmentAssessmentMode? @map("assessment_mode")
  sourceValidation    Json?                      @map("source_validation")
  contentVersion      String?                    @map("content_version")

  evidenceBoard RecruitmentCandidateEvidence[]

  @@index([candidateId, sequenceNum])
  @@map("recruitment_interactions")
}

// Integrity/activity trail: paste events, tab-visibility changes, window blur.
// Content is NOT captured (only length for pastes) so we don't accidentally
// store sensitive clipboard data. Surfaced to examiners alongside the AI trail.
model RecruitmentActivityEvent {
  id          String               @id @default(uuid()) @db.Uuid
  candidateId String               @map("candidate_id")
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  occurredAt  DateTime             @default(now()) @map("occurred_at")
  eventType   String               @map("event_type") // paste | visibility_hidden | visibility_visible | email_delivered | chat_opened
  taskNumber  Int?                 @map("task_number") // 1 | 2 | null (window-level events)
  metadata    Json? // { charCount } for paste, { hiddenMs } for visibility_visible, { emailId } for email_delivered, { scriptId } for chat_opened

  @@index([candidateId, occurredAt])
  @@map("recruitment_activity_events")
}

// ============================================================================
// RECRUITMENT SCENARIO BUILDER (admin-authored scenarios)
// ============================================================================
// Legacy scenarios live in code (src/lib/recruit/*.ts) and are loaded by id.
// Custom scenarios live in these tables and are referenced from
// RecruitmentAssessment.customScenarioId. A single loader
// (src/lib/recruit/scenario-loader.ts) normalises both sources into the same
// RecruitScenarioConfig shape so the candidate UI doesn't care where the
// scenario came from.

model RecruitmentScenario {
  id                       String    @id @default(cuid())
  slug                     String    @unique // URL segment: /assess/<slug>
  title                    String
  organisation             String
  positionTitle            String    @map("position_title")
  defaultTotalMinutes      Int       @default(90) @map("default_total_minutes")
  status                   String    @default("draft") // draft | published | archived
  publishedAt              DateTime? @map("published_at")
  // Parsed JD text saved when the scenario is generated by AI from a job
  // description. Admins-only — never exposed to candidates. Used to feed the
  // model on Regenerate without requiring a re-upload.
  jdSourceText             String?   @map("jd_source_text") @db.Text
  // Source-agnostic, human-confirmed review of the role requirements used to
  // design this assessment. The JSON record retains decisions (including
  // exclusions), source provenance and the design-evidence disclaimer.
  roleEvidenceRecord       Json?     @map("role_evidence_record")
  roleEvidenceReviewedById String?   @map("role_evidence_reviewed_by_id")
  roleEvidenceReviewedAt   DateTime? @map("role_evidence_reviewed_at")
  createdById              String?   @map("created_by_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  assessmentMode       RecruitmentAssessmentMode @default(EVIDENCE) @map("assessment_mode")
  modePolicyVersion    String                    @default("1") @map("mode_policy_version")
  defenceEnabled       Boolean                   @default(false) @map("defence_enabled")
  defenceQuestionCount Int                       @default(2) @map("defence_question_count")
  defenceMinutes       Int                       @default(5) @map("defence_minutes")

  tasks                  RecruitmentScenarioTask[]
  exhibits               RecruitmentScenarioExhibit[]
  emails                 RecruitmentScenarioEmail[]
  chatScripts            RecruitmentScenarioChatScript[]
  assessments            RecruitmentAssessment[]
  criteria               RecruitmentScenarioCriterion[]
  validationRuns         RecruitmentScenarioValidationRun[]
  reviews                RecruitmentScenarioReview[]
  publicationOverrides   RecruitmentScenarioPublicationOverride[]
  assessmentVersions     RecruitmentAssessmentVersion[]
  psychometricProgrammes RecruitmentPsychometricProgramme[]

  @@map("recruitment_scenarios")
}

// One row per task on a scenario. kind discriminates the shape:
//   - "memo_ai":      systemPrompt + exhibitId + deliverable* are required
//   - "email_inbox":  emails relation carries the scripted messages
//   - "chat":         chatScripts relation carries the persona config
// config is a Json extension point for kind-specific fields we haven't
// promoted to columns yet (keeps migrations cheap during iteration).
model RecruitmentScenarioTask {
  id            String              @id @default(cuid())
  scenarioId    String              @map("scenario_id")
  scenario      RecruitmentScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  number        Int // 1..n ordinal within scenario
  kind          String // memo_ai | email_inbox | chat
  title         String
  briefMarkdown String              @map("brief_markdown") @db.Text
  totalMarks    Int                 @default(0) @map("total_marks")

  // memo_ai-specific (nullable for other kinds)
  systemPrompt           String?                     @map("system_prompt") @db.Text
  exhibitId              String?                     @map("exhibit_id")
  exhibit                RecruitmentScenarioExhibit? @relation(fields: [exhibitId], references: [id], onDelete: SetNull)
  deliverableLabel       String?                     @map("deliverable_label")
  deliverablePlaceholder String?                     @map("deliverable_placeholder") @db.Text

  config Json? // kind-specific overrides

  // Per-task marking rubric (admin/marker-only — never sent to candidates).
  // Shape mirrors the legacy infra/recruit/<id>/marking_rubric.json categories:
  //   { technical: { max, description, embedded_issues:[{id,title,max_marks,expected}] },
  //     investigation_quality: { max, description, indicators:[] },
  //     professional_skills:   { max, description, indicators:[] },
  //     judgment?: { max, description, rubric:{ "<band>": "<descriptor>" } } }
  // Auto-generated by the task-generator Lambda alongside the task; null when
  // generation failed soft (the marking screen degrades to an empty panel).
  rubric Json? @map("rubric")

  emails            RecruitmentScenarioEmail[]
  chatScripts       RecruitmentScenarioChatScript[]
  criterionMappings RecruitmentScenarioCriterionTask[]
  candidateEvidence RecruitmentCandidateEvidence[]

  @@unique([scenarioId, number])
  @@index([scenarioId])
  @@map("recruitment_scenario_tasks")
}

model RecruitmentScenarioExhibit {
  id         String              @id @default(cuid())
  scenarioId String              @map("scenario_id")
  scenario   RecruitmentScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  title      String
  html       String              @db.Text
  // Human-readable stable ID used in model context and evidence citations.
  // Null is retained for historical exhibits; loaders fall back to the row id.
  sourceId   String?             @map("source_id")

  tasks RecruitmentScenarioTask[]

  @@unique([scenarioId, sourceId])
  @@index([scenarioId])
  @@map("recruitment_scenario_exhibits")
}

// Candidate-owned working evidence. It is a study aid and provenance record,
// never an automated score. Candidate APIs always scope by authenticated token.
model RecruitmentCandidateEvidence {
  id                       String                                @id @default(cuid())
  candidateId              String                                @map("candidate_id")
  candidate                RecruitmentCandidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  taskId                   String?                               @map("task_id")
  task                     RecruitmentScenarioTask?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskNumber               Int                                   @map("task_number")
  interactionId            String?                               @map("interaction_id") @db.Uuid
  interaction              RecruitmentInteraction?               @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  evidenceCardId           String                                @map("evidence_card_id")
  claim                    String                                @db.Text
  sourceId                 String?                               @map("source_id")
  sourceTitle              String?                               @map("source_title")
  sourceExcerpt            String?                               @map("source_excerpt") @db.Text
  sourceVerificationStatus RecruitmentEvidenceVerificationStatus @map("source_verification_status")
  candidateDisposition     RecruitmentEvidenceDisposition        @default(SAVED) @map("candidate_disposition")
  createdAt                DateTime                              @default(now()) @map("created_at")
  updatedAt                DateTime                              @updatedAt @map("updated_at")

  @@unique([candidateId, interactionId, evidenceCardId])
  @@index([candidateId, taskNumber])
  @@map("recruitment_candidate_evidence")
}

// Two-question written reasoning defence. Questions are generated once and
// persisted; deterministic fallbacks keep the timed candidate flow available.
model RecruitmentCandidateDefence {
  id              String                    @id @default(cuid())
  candidateId     String                    @unique @map("candidate_id")
  candidate       RecruitmentCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentMode  RecruitmentAssessmentMode @map("assessment_mode")
  status          String                    @default("questions_ready")
  questions       Json
  answers         Json
  personalised    Boolean                   @default(false)
  model           String?
  promptVersion   String                    @map("prompt_version")
  contentVersion  String                    @default("1") @map("content_version")
  generationError String?                   @map("generation_error") @db.Text
  startedAt       DateTime                  @map("started_at")
  deadline        DateTime
  submittedAt     DateTime?                 @map("submitted_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  createdAt       DateTime                  @default(now()) @map("created_at")

  @@index([status, deadline])
  @@map("recruitment_candidate_defences")
}

// Stable criteria and explicit blueprint mappings for DB-authored scenarios.
model RecruitmentScenarioCriterion {
  id                   String              @id @default(cuid())
  scenarioId           String              @map("scenario_id")
  scenario             RecruitmentScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  description          String              @db.Text
  sourceRequirement    String?             @map("source_requirement") @db.Text
  observableBehaviours Json                @map("observable_behaviours")
  roleEvidence         Json?               @map("role_evidence")
  order                Int                 @default(0)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  taskMappings RecruitmentScenarioCriterionTask[]

  @@unique([scenarioId, code])
  @@index([scenarioId, order])
  @@map("recruitment_scenario_criteria")
}

model RecruitmentScenarioCriterionTask {
  id                        String                       @id @default(cuid())
  criterionId               String                       @map("criterion_id")
  criterion                 RecruitmentScenarioCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  taskId                    String                       @map("task_id")
  task                      RecruitmentScenarioTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expectedCandidateEvidence String                       @map("expected_candidate_evidence") @db.Text
  rubricElementIds          Json                         @map("rubric_element_ids")
  marks                     Int                          @default(0)
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")

  @@unique([criterionId, taskId])
  @@index([taskId])
  @@map("recruitment_scenario_criterion_tasks")
}

model RecruitmentScenarioValidationRun {
  id                  String                         @id @default(cuid())
  scenarioId          String                         @map("scenario_id")
  scenario            RecruitmentScenario            @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioHash        String                         @map("scenario_hash")
  assessmentMode      RecruitmentAssessmentMode      @map("assessment_mode")
  status              RecruitmentValidationRunStatus @default(QUEUED)
  progressStage       String                         @default("Preparing scenario snapshot") @map("progress_stage")
  overallReadiness    String?                        @map("overall_readiness")
  promptVersion       String                         @map("prompt_version")
  model               String
  contentVersion      String                         @default("1") @map("content_version")
  // Immutable model input captured when the run is queued. The worker reads
  // this snapshot so later edits cannot be analysed under an older hash.
  scenarioSnapshot    Json?                          @map("scenario_snapshot")
  deterministicChecks Json?                          @map("deterministic_checks")
  findings            Json?
  criterionCoverage   Json?                          @map("criterion_coverage")
  syntheticProfiles   Json?                          @map("synthetic_profiles")
  policyTests         Json?                          @map("policy_tests")
  summary             String?                        @db.Text
  error               String?                        @db.Text
  createdById         String                         @map("created_by_id")
  createdBy           User                           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  startedAt           DateTime?                      @map("started_at")
  completedAt         DateTime?                      @map("completed_at")
  createdAt           DateTime                       @default(now()) @map("created_at")

  reviews RecruitmentScenarioReview[]

  @@index([scenarioId, createdAt])
  @@index([status, createdAt])
  @@map("recruitment_scenario_validation_runs")
}

model RecruitmentScenarioReview {
  id              String                            @id @default(cuid())
  scenarioId      String                            @map("scenario_id")
  scenario        RecruitmentScenario               @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  validationRunId String?                           @map("validation_run_id")
  validationRun   RecruitmentScenarioValidationRun? @relation(fields: [validationRunId], references: [id], onDelete: SetNull)
  reviewType      RecruitmentScenarioReviewType     @map("review_type")
  decision        RecruitmentScenarioReviewDecision
  notes           String                            @db.Text
  reviewerId      String                            @map("reviewer_id")
  reviewer        User                              @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt       DateTime                          @default(now()) @map("created_at")

  @@index([scenarioId, createdAt])
  @@index([validationRunId])
  @@map("recruitment_scenario_reviews")
}

model RecruitmentScenarioPublicationOverride {
  id           String              @id @default(cuid())
  scenarioId   String              @map("scenario_id")
  scenario     RecruitmentScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioHash String              @map("scenario_hash")
  reason       String              @db.Text
  userId       String              @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([scenarioId, createdAt])
  @@map("recruitment_scenario_publication_overrides")
}

// Immutable, content-addressed assessment version. The JSON snapshot contains
// the exact scenario, tasks, exhibits, rubrics, criteria and mode policy used
// for delivery and marking. A changed scenario hash creates a new version.
model RecruitmentAssessmentVersion {
  id                String                    @id @default(cuid())
  scenarioId        String                    @map("scenario_id")
  scenario          RecruitmentScenario       @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  scenarioHash      String                    @map("scenario_hash")
  label             String
  scenarioSnapshot  Json                      @map("scenario_snapshot")
  assessmentMode    RecruitmentAssessmentMode @map("assessment_mode")
  modePolicyVersion String                    @map("mode_policy_version")
  createdById       String                    @map("created_by_id")
  createdBy         User                      @relation("AssessmentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now()) @map("created_at")

  assessments            RecruitmentAssessment[]
  psychometricProgrammes RecruitmentPsychometricProgramme[]

  @@unique([scenarioId, scenarioHash])
  @@index([scenarioId, createdAt])
  @@map("recruitment_assessment_versions")
}

// A validity argument is specific to an intended score interpretation, use,
// population and immutable assessment version. It is not a generic badge.
model RecruitmentPsychometricProgramme {
  id                             String                                 @id @default(cuid())
  scenarioId                     String                                 @map("scenario_id")
  scenario                       RecruitmentScenario                    @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  assessmentVersionId            String                                 @map("assessment_version_id")
  assessmentVersion              RecruitmentAssessmentVersion           @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict)
  name                           String
  intendedUse                    String                                 @map("intended_use") @db.Text
  targetPopulation               String                                 @map("target_population") @db.Text
  constructDefinition            String                                 @map("construct_definition") @db.Text
  decisionContext                String                                 @map("decision_context") @db.Text
  status                         RecruitmentPsychometricProgrammeStatus @default(DRAFT)
  conclusion                     RecruitmentPsychometricConclusion      @default(NOT_EVALUATED)
  limitations                    String?                                @db.Text
  independentReviewerName        String?                                @map("independent_reviewer_name")
  independentReviewerCredentials String?                                @map("independent_reviewer_credentials") @db.Text
  reviewedAt                     DateTime?                              @map("reviewed_at")
  createdById                    String                                 @map("created_by_id")
  createdBy                      User                                   @relation("PsychometricProgrammeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                      DateTime                               @default(now()) @map("created_at")
  updatedAt                      DateTime                               @updatedAt @map("updated_at")

  evidenceRecords  RecruitmentPsychometricEvidence[]
  pilotCohorts     RecruitmentPsychometricPilotCohort[]
  raterAssignments RecruitmentPsychometricRaterAssignment[]

  @@index([scenarioId, createdAt])
  @@index([assessmentVersionId])
  @@map("recruitment_psychometric_programmes")
}

model RecruitmentPsychometricEvidence {
  id                String                                  @id @default(cuid())
  programmeId       String                                  @map("programme_id")
  programme         RecruitmentPsychometricProgramme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  category          RecruitmentPsychometricEvidenceCategory
  status            RecruitmentPsychometricEvidenceStatus   @default(NOT_STARTED)
  summary           String?                                 @db.Text
  methodology       String?                                 @db.Text
  sampleDescription String?                                 @map("sample_description") @db.Text
  findings          String?                                 @db.Text
  limitations       String?                                 @db.Text
  updatedById       String                                  @map("updated_by_id")
  updatedBy         User                                    @relation("PsychometricEvidenceUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt         DateTime                                @default(now()) @map("created_at")
  updatedAt         DateTime                                @updatedAt @map("updated_at")

  @@unique([programmeId, category])
  @@index([programmeId, status])
  @@map("recruitment_psychometric_evidence")
}

model RecruitmentPsychometricPilotCohort {
  id                       String                           @id @default(cuid())
  programmeId              String                           @map("programme_id")
  programme                RecruitmentPsychometricProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  assessmentId             String                           @map("assessment_id")
  assessment               RecruitmentAssessment            @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  versionBasis             RecruitmentPilotVersionBasis     @map("version_basis")
  retrospectiveAttestation String?                          @map("retrospective_attestation") @db.Text
  includedAt               DateTime                         @default(now()) @map("included_at")

  @@unique([programmeId, assessmentId])
  @@index([assessmentId])
  @@map("recruitment_psychometric_pilot_cohorts")
}

// Independent study ratings are held separately from operational marks. A
// rater sees anonymous candidate work and the frozen rubric, never another
// rater's scores or the operational hiring score while their work is open.
model RecruitmentPsychometricRaterAssignment {
  id          String                           @id @default(cuid())
  programmeId String                           @map("programme_id")
  programme   RecruitmentPsychometricProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  candidateId String                           @map("candidate_id")
  candidate   RecruitmentCandidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  raterId     String                           @map("rater_id")
  rater       User                             @relation("PsychometricRater", fields: [raterId], references: [id], onDelete: Restrict)
  sequence    Int
  status      RecruitmentRaterAssignmentStatus @default(ASSIGNED)
  dueAt       DateTime?                        @map("due_at")
  submittedAt DateTime?                        @map("submitted_at")
  createdAt   DateTime                         @default(now()) @map("created_at")
  updatedAt   DateTime                         @updatedAt @map("updated_at")

  ratings RecruitmentPsychometricRating[]

  @@unique([programmeId, candidateId, raterId], map: "psych_rater_assignment_candidate_rater_key")
  @@index([raterId, status])
  @@index([programmeId, candidateId], map: "psych_rater_assignment_programme_candidate_idx")
  @@map("recruitment_psychometric_rater_assignments")
}

model RecruitmentPsychometricRating {
  id              String                                 @id @default(cuid())
  assignmentId    String                                 @map("assignment_id")
  assignment      RecruitmentPsychometricRaterAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  responseId      String                                 @map("response_id")
  response        RecruitmentResponse                    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  taskNumber      Int                                    @map("task_number")
  score           Float
  criterionScores Json?                                  @map("criterion_scores")
  comments        String?                                @db.Text
  submittedAt     DateTime?                              @map("submitted_at")
  createdAt       DateTime                               @default(now()) @map("created_at")
  updatedAt       DateTime                               @updatedAt @map("updated_at")

  @@unique([assignmentId, responseId])
  @@index([responseId])
  @@map("recruitment_psychometric_ratings")
}

// Scripted emails that arrive during an email_inbox task. triggerOffsetSeconds
// is relative to RecruitmentCandidate.startedAt. The polling endpoint
// (/api/assess/events) reveals an email once elapsed >= offset and writes an
// email_delivered activity event for idempotency.
model RecruitmentScenarioEmail {
  id                   String                  @id @default(cuid())
  scenarioId           String                  @map("scenario_id")
  scenario             RecruitmentScenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  taskId               String                  @map("task_id")
  task                 RecruitmentScenarioTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orderIndex           Int                     @default(0) @map("order_index")
  triggerOffsetSeconds Int                     @map("trigger_offset_seconds")
  senderName           String                  @map("sender_name")
  senderEmail          String                  @map("sender_email")
  subject              String
  bodyHtml             String                  @map("body_html") @db.Text
  expectedAction       String                  @map("expected_action") // reply | ignore | flag | forward
  markerNotes          String?                 @map("marker_notes") @db.Text

  @@index([scenarioId, triggerOffsetSeconds])
  @@index([taskId, orderIndex])
  @@map("recruitment_scenario_emails")
}

// Persona-chat script that fires once during the assessment. MVP supports
// AI persona only (Claude with an admin-authored system prompt). Scripted
// dialogue trees are a follow-up; the schema reserves room by storing the
// persona identity + opener + prompt directly.
model RecruitmentScenarioChatScript {
  id                   String                  @id @default(cuid())
  scenarioId           String                  @map("scenario_id")
  scenario             RecruitmentScenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  taskId               String                  @map("task_id")
  task                 RecruitmentScenarioTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  triggerOffsetSeconds Int                     @map("trigger_offset_seconds")
  personaName          String                  @map("persona_name")
  personaRole          String                  @map("persona_role")
  openerMessage        String                  @map("opener_message") @db.Text
  systemPrompt         String                  @map("system_prompt") @db.Text
  maxTurns             Int                     @default(8) @map("max_turns")
  expectedOutcomes     String?                 @map("expected_outcomes") @db.Text

  @@index([scenarioId, triggerOffsetSeconds])
  @@index([taskId])
  @@map("recruitment_scenario_chat_scripts")
}

// Candidate's response to a scripted email. One row per (candidate, email).
// deliveredAt captures when the server first revealed the email so marker
// analytics can compute response latency.
model RecruitmentEmailResponse {
  id          String               @id @default(cuid())
  candidateId String               @map("candidate_id")
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // emailId is a plain identifier, NOT a foreign key: scripted emails can come
  // from a DB scenario (RecruitmentScenarioEmail row) OR a code scenario
  // (config-only id, e.g. "ipac-email-ed-deadline"). The reply route validates
  // the id against the resolved scenario config. Mirrors how persona-chat
  // interactions (RecruitmentInteraction) carry no scenario FK.
  emailId     String               @map("email_id")
  action      String // replied | ignored | flagged
  replyBody   String?              @map("reply_body") @db.Text
  deliveredAt DateTime             @map("delivered_at")
  respondedAt DateTime             @default(now()) @map("responded_at")

  // Marker output (parallels RecruitmentResponse's per-row comment pattern)
  markerComment String? @map("marker_comment") @db.Text

  @@unique([candidateId, emailId])
  @@index([candidateId])
  @@map("recruitment_email_responses")
}

// ============================================================================
// AI scenario generation jobs (background-job pattern; SQS + worker Lambda)
// ============================================================================
// The from-JD wizard kicks off generation by inserting a row here and posting
// to SQS. A worker Lambda picks it up, calls Anthropic, and writes the result
// back. Wizard polls the status endpoint until status is completed/failed.
// Lives in this table because: (a) survives Lambda recycling, (b) gives us a
// queryable trail of generations for debug, (c) shared between SSR + worker.
model RecruitmentScenarioGenerationJob {
  id           String    @id @default(cuid())
  createdById  String?   @map("created_by_id")
  status       String    @default("queued") // queued | running | completed | failed
  inputJson    Json      @map("input_json")
  resultJson   Json?     @map("result_json")
  errorMessage String?   @map("error_message") @db.Text
  enqueuedAt   DateTime  @default(now()) @map("enqueued_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")

  @@index([status, enqueuedAt])
  @@map("recruitment_scenario_generation_jobs")
}
