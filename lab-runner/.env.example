# Deployment-only configuration. Never copy these values into browser/public env.
LAB_RUNNER_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LAB_RUNNER_OWNER=pilot
LAB_CLUSTER_UID=REPLACE_WITH_KUBE_SYSTEM_NAMESPACE_UID
LAB_RUNTIME_CLASS=assessment-sandbox
LAB_RUNTIME_HANDLER=runsc
LAB_WORKSPACE_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256_DIGEST
# Exact Kubernetes service VIP and real control-plane destination IPs; no broad CIDRs.
LAB_API_CIDRS=10.0.0.1/32
LAB_API_PORTS=443,6443
KUBECONFIG=/run/cluster/kubeconfig
LAB_DB_PATH=/data/labs.sqlite3
LAB_MAX_CONCURRENT=10
# Bind externally only behind an authenticated private TLS ingress/reverse proxy.
LAB_LISTEN=127.0.0.1
PORT=8080
# Set true only after verifying the deployment prerequisites in README.md.
LAB_DEDICATED_CLUSTER=false
LAB_NETWORK_POLICY_VERIFIED=false
LAB_NODE_ISOLATION_VERIFIED=false
